.profile-edit-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 10%, rgba(255, 139, 24, 0.16), transparent 28%),
    radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.96), transparent 26%),
    #fff8ef;
  color: #1f2733;
}

.profile-edit-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: #7b4a24;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.profile-edit-loading image {
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 18rpx;
  filter: drop-shadow(0 18rpx 28rpx rgba(133, 78, 24, 0.14));
}

.profile-edit-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 166rpx;
  margin: 4rpx 0 22rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 2;
  max-width: 450rpx;
}

.page-title {
  display: block;
  color: #1f2733;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #7d828a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-coach {
  position: absolute;
  right: -28rpx;
  bottom: -48rpx;
  width: 250rpx;
  height: 228rpx;
  filter: drop-shadow(0 18rpx 28rpx rgba(133, 78, 24, 0.14));
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  margin-bottom: 0;
  color: #1f2733;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.section-note {
  color: #a7896b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  color: #7b4a24;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

input {
  height: 84rpx;
  width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #efd8bd;
  border-radius: 18rpx;
  background: rgba(255, 250, 242, 0.96);
  color: #1f2733;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.measure-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.choice-grid {
  display: grid;
  gap: 14rpx;
  width: 100%;
  grid-auto-rows: 78rpx;
  align-items: stretch;
}

.choice-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.choice-grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.habit-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.choice-grid button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 78rpx;
  min-height: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fff5e8;
  color: #1f2733;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: none;
  overflow: hidden;
  white-space: nowrap;
}

.choice-grid button.active {
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 16, 0.14);
}

.save-area {
  padding: 10rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  margin: 2rpx -24rpx 0;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 430rpx;
  height: 90rpx;
  margin: 0 auto;
  padding: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}
