<view class="page profile-page" wx:if="{{!loading}}">
  <view class="profile-card">
    <view class="profile-copy">
      <text class="profile-name">{{user.nickname}}</text>
      <text class="profile-subtitle">霸气按目标盯进度</text>
      <view class="profile-tags">
        <text class="tag-goal">{{display.goal}}</text>
        <text>{{user.weight}}kg</text>
        <text>{{user.height}}cm</text>
      </view>
      <view class="profile-meta">
        <text>性别：{{display.gender}}</text>
        <text></text>
        <text>年龄：{{user.age}}</text>
      </view>
    </view>
    <view class="profile-visual">
      <image class="profile-coach" src="/assets/coach/coach-waist.png" mode="aspectFit"></image>
    </view>
  </view>

  <view class="plan-card" wx:if="{{plan}}">
    <view class="plan-title-row">
      <text class="plan-title">热量计划</text>
      <text class="formula-link" bindtap="toggleFormula">计算公式</text>
    </view>
    <view class="plan-main">
      <text>建议摄入</text>
      <text>{{plan.targetCalories}} kcal</text>
    </view>
    <view class="plan-grid">
      <view><text>基础代谢</text><text>{{plan.bmr}} kcal</text></view>
      <view><text>日常活动</text><text>{{plan.habitBurn}} kcal</text></view>
      <view><text>目标调整</text><text>{{plan.calorieAdjustment}} kcal</text></view>
    </view>
    <view class="macro-plan">
      <view class="macro-row protein-row">
        <view class="macro-left"><text class="macro-icon">P</text><text class="macro-name">蛋白质：{{plan.proteinTarget}}g</text><text class="macro-note">（{{display.proteinNote}}）</text></view>
      </view>
      <view class="macro-row carb-row">
        <view class="macro-left"><text class="macro-icon">C</text><text class="macro-name">碳水：{{plan.carbTarget}}g</text><text class="macro-note">（{{display.carbNote}}）</text></view>
      </view>
      <view class="macro-row fat-row">
        <view class="macro-left"><text class="macro-icon">F</text><text class="macro-name">脂肪：{{plan.fatTarget}}g</text><text class="macro-note">（{{display.fatNote}}）</text></view>
      </view>
    </view>
  </view>

  <button class="primary-button edit-button" bindtap="edit">
    <text class="edit-icon">▣</text>
    <text>修改资料</text>
  </button>
  <text class="profile-footer">每一次更新，都是更好的自己！</text>
</view>

<view class="formula-overlay" wx:if="{{showFormula}}" bindtap="toggleFormula">
  <view class="formula-modal">
    <text class="formula-modal-title">每日摄入计算方案</text>
    <scroll-view class="formula-scroll" scroll-y>
      <view class="formula-section">
        <text class="formula-heading">基础代谢（Mifflin-St Jeor 公式）</text>
        <text class="formula-item">男性：10 × 体重 + 6.25 × 身高 - 5 × 年龄 + 5</text>
        <text class="formula-item">女性：10 × 体重 + 6.25 × 身高 - 5 × 年龄 - 161</text>
      </view>
      <view class="formula-section">
        <text class="formula-heading">总消耗（TDEE）</text>
        <text class="formula-item">基础代谢 × 1.2（静坐少动系数）</text>
      </view>
      <view class="formula-section">
        <text class="formula-heading">目标热量</text>
        <text class="formula-item">减脂：TDEE - 350 kcal</text>
        <text class="formula-item">维持：TDEE</text>
        <text class="formula-item">增肌：TDEE + 250 kcal</text>
      </view>
      <view class="formula-section">
        <text class="formula-heading">蛋白质目标（调整体重法）</text>
        <text class="formula-item">理想体重：男 (身高 - 100) × 0.9，女 (身高 - 100) × 0.85</text>
        <text class="formula-item">调整体重 = 理想体重 + 超出部分的 40%</text>
        <text class="formula-item">蛋白体重取调整体重与当前体重一半的较大值</text>
        <text class="formula-item">减脂：蛋白体重 × 2.0g · 维持 × 1.6g · 增肌 × 1.8g</text>
      </view>
      <view class="formula-section">
        <text class="formula-heading">脂肪目标</text>
        <text class="formula-item">目标热量 × 25% ÷ 9</text>
      </view>
      <view class="formula-section">
        <text class="formula-heading">碳水目标</text>
        <text class="formula-item">（目标热量 - 蛋白 × 4 - 脂肪 × 9）÷ 4</text>
      </view>
    </scroll-view>
    <text class="formula-close" catchtap="toggleFormula">我知道了</text>
  </view>
</view>
