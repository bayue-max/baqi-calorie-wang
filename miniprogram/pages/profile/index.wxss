.profile-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 54rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 84% 10%, rgba(255, 139, 24, 0.16), transparent 28%),
    radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.95), transparent 24%),
    #fff8ef;
  color: #1f2733;
}

.profile-card,
.plan-card {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  border: 1rpx solid rgba(239, 219, 195, 0.96);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 40rpx rgba(74, 48, 23, 0.07);
}

.profile-card {
  display: flex;
  min-height: 286rpx;
  padding: 34rpx 30rpx 30rpx;
  overflow: hidden;
}

.profile-card::after {
  content: "";
  position: absolute;
  right: -42rpx;
  top: -50rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 143, 24, 0.12), transparent 70%);
}

.profile-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding-right: 238rpx;
}

.profile-name {
  display: block;
  color: #1f2733;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.profile-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7d828a;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.25;
}

.profile-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.profile-tags text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fff1df;
  color: #8f521a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-tags .tag-goal {
  color: #ff7a10;
}

.profile-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  color: #7b4a24;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-meta text:nth-child(2) {
  width: 2rpx;
  height: 28rpx;
  background: rgba(123, 74, 36, 0.36);
}

.profile-visual {
  position: absolute;
  right: -22rpx;
  top: -12rpx;
  width: 332rpx;
  height: 312rpx;
  z-index: 1;
}

.profile-coach {
  position: absolute;
  right: -34rpx;
  bottom: -20rpx;
  width: 326rpx;
  height: 306rpx;
  filter: drop-shadow(0 18rpx 28rpx rgba(133, 78, 24, 0.14));
}

.coach-bubble {
  position: absolute;
  left: -2rpx;
  top: 2rpx;
  z-index: 3;
  padding: 12rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff8f18, #ff7a10);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
  box-shadow: 0 14rpx 26rpx rgba(255, 122, 16, 0.16);
}

.coach-bubble::after {
  content: "";
  position: absolute;
  right: -8rpx;
  bottom: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff7a10;
  transform: rotate(45deg);
}

.coach-bubble text {
  display: block;
}

.plan-card {
  margin-top: 22rpx;
  padding: 34rpx 28rpx 34rpx;
}

.plan-title {
  display: block;
  margin-bottom: 26rpx;
  color: #1f2733;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.12;
}

.plan-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 30rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #151d29, #202b3a);
  color: #fff8ef;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

.plan-main text:first-child {
  font-size: 30rpx;
  font-weight: 900;
}

.plan-main text:last-child {
  color: #ffb13d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.plan-grid view {
  min-height: 98rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fffaf2;
}

.plan-grid text {
  display: block;
  color: #7b4a24;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
}

.plan-grid text:last-child {
  margin-top: 14rpx;
  color: #1f2733;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
}

.macro-plan {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 30rpx;
}

.macro-row {
  display: flex;
  align-items: center;
  min-height: 48rpx;
}

.macro-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.macro-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: #ff8f18;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.macro-name {
  color: #1f2733;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.macro-note {
  min-width: 0;
  color: #7b4a24;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.2;
}

.edit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 410rpx;
  height: 92rpx;
  margin: 28rpx auto 0;
  padding: 0;
  border-radius: 28rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.edit-icon {
  font-size: 30rpx;
  line-height: 1;
}

.profile-footer {
  display: block;
  margin-top: 20rpx;
  color: #9a5a12;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}
