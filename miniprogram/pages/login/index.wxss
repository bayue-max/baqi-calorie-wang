.login-page {
  position: relative;
  min-height: 100vh;
  padding: 88rpx 48rpx 44rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 72% 18%, rgba(255, 139, 24, 0.16), transparent 34%),
    radial-gradient(circle at 22% 58%, rgba(255, 183, 86, 0.12), transparent 32%),
    #fff7ec;
}

.login-page::before,
.login-page::after {
  content: "";
  position: absolute;
  z-index: 0;
  border-radius: 999rpx;
  opacity: 0.55;
}

.login-page::before {
  top: 276rpx;
  left: 96rpx;
  width: 74rpx;
  height: 74rpx;
  background:
    radial-gradient(circle at 18rpx 18rpx, rgba(255, 221, 177, 0.82) 0 11rpx, transparent 12rpx),
    radial-gradient(circle at 48rpx 16rpx, rgba(255, 221, 177, 0.82) 0 11rpx, transparent 12rpx),
    radial-gradient(circle at 22rpx 50rpx, rgba(255, 221, 177, 0.82) 0 11rpx, transparent 12rpx),
    radial-gradient(circle at 54rpx 48rpx, rgba(255, 221, 177, 0.82) 0 11rpx, transparent 12rpx);
}

.login-page::after {
  right: 74rpx;
  top: 694rpx;
  width: 54rpx;
  height: 54rpx;
  border: 8rpx solid rgba(255, 218, 172, 0.62);
  transform: rotate(38deg);
}

.login-visual {
  position: relative;
  z-index: 1;
  height: 790rpx;
}

.coach-main,
.coach-jump,
.coach-rice {
  position: absolute;
  display: block;
  filter: drop-shadow(0 20rpx 30rpx rgba(133, 78, 24, 0.14));
}

.coach-main {
  left: -76rpx;
  bottom: 66rpx;
  width: 540rpx;
  height: 640rpx;
  z-index: 2;
}

.coach-jump {
  right: -2rpx;
  top: -4rpx;
  width: 330rpx;
  height: 330rpx;
  z-index: 2;
}

.coach-rice {
  right: 12rpx;
  bottom: 52rpx;
  width: 274rpx;
  height: 274rpx;
  z-index: 3;
}

.bubble {
  position: absolute;
  z-index: 5;
  padding: 18rpx 24rpx;
  border: 2rpx solid rgba(255, 171, 85, 0.46);
  border-radius: 26rpx;
  background: rgba(255, 250, 242, 0.92);
  color: #ff7a10;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.34;
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 16, 0.08);
}

.bubble::after {
  content: "";
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-right: 2rpx solid rgba(255, 171, 85, 0.46);
  border-bottom: 2rpx solid rgba(255, 171, 85, 0.46);
  background: rgba(255, 250, 242, 0.92);
}

.bubble text {
  display: block;
}

.bubble-jump {
  right: 258rpx;
  top: 58rpx;
}

.bubble-jump::after {
  right: -11rpx;
  top: 56rpx;
  transform: rotate(-45deg);
}

.bubble-food {
  right: 252rpx;
  bottom: 48rpx;
}

.bubble-food::after {
  right: -11rpx;
  top: 42rpx;
  transform: rotate(-45deg);
}

.spark-deco {
  position: absolute;
  left: 400rpx;
  bottom: 152rpx;
  z-index: 4;
  color: #ffb33f;
  font-size: 44rpx;
  font-weight: 900;
}

.brand-block {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -8rpx;
  text-align: center;
}

.title {
  display: block;
  color: #111820;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 1.02;
  letter-spacing: 0;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  max-width: 560rpx;
  color: #7f7166;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.42;
  text-align: center;
}

.login-actions {
  position: relative;
  z-index: 2;
  margin-top: 44rpx;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.login-button::after {
  border: 0;
}

.primary-button.login-button {
  gap: 18rpx;
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 16, 0.2);
}

.secondary-button {
  border: 1rpx solid rgba(239, 219, 195, 0.96);
  background: rgba(255, 250, 242, 0.86);
  color: #1f2733;
}

.wechat-mark {
  position: relative;
  width: 58rpx;
  height: 42rpx;
  flex: 0 0 58rpx;
}

.wechat-mark view {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
}

.wechat-mark view::before,
.wechat-mark view::after {
  content: "";
  position: absolute;
  top: 15rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ff7a10;
}

.wechat-mark view:nth-child(1) {
  left: 0;
  top: 0;
  width: 38rpx;
  height: 30rpx;
}

.wechat-mark view:nth-child(1)::before {
  left: 10rpx;
}

.wechat-mark view:nth-child(1)::after {
  left: 22rpx;
}

.wechat-mark view:nth-child(2) {
  right: 0;
  bottom: 0;
  width: 34rpx;
  height: 27rpx;
}

.wechat-mark view:nth-child(2)::before {
  left: 9rpx;
}

.wechat-mark view:nth-child(2)::after {
  left: 20rpx;
}

.agreement {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 30rpx;
  color: #9b938d;
  font-size: 23rpx;
  font-weight: 600;
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border: 3rpx solid #ff8f18;
  border-radius: 50%;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.agreement-check.checked {
  border-color: #ff7a10;
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
}

.agreement-link {
  color: #ff7a10;
  font-weight: 900;
}
