.home-page {
  min-height: 100vh;
  padding: 30rpx 28rpx 178rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  background:
    radial-gradient(circle at 88% 6%, rgba(255, 139, 28, 0.16), transparent 25%),
    radial-gradient(circle at 8% 18%, rgba(255, 255, 255, 0.95), transparent 22%),
    #fff8ef;
  color: #1f2733;
}

.home-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 184rpx;
  margin: 8rpx 0 18rpx;
  padding: 26rpx 0 16rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  overflow: hidden;
}

.home-hero::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: -20rpx;
  width: 300rpx;
  height: 210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 154, 37, 0.26) 0%, rgba(255, 196, 112, 0.15) 45%, rgba(255, 247, 236, 0) 74%);
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding-top: 0;
}

.brand-name {
  display: block;
  max-width: 430rpx;
  font-size: 64rpx;
  line-height: 1.04;
  font-weight: 900;
  letter-spacing: 0;
  color: #1f2733;
  text-shadow: 0 8rpx 24rpx rgba(72, 44, 19, 0.06);
}

.coach-line {
  display: block;
  margin-top: 10rpx;
  color: #7d828a;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 600;
}

.coach-medal {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 198rpx;
  height: 188rpx;
  margin: 0;
  z-index: 2;
}

.coach-avatar-img {
  position: absolute;
  right: 0;
  top: 8rpx;
  display: block;
  width: 178rpx;
  height: 178rpx;
  z-index: 3;
  filter: drop-shadow(0 16rpx 30rpx rgba(133, 78, 24, 0.14));
}

.hero-note-card {
  position: absolute;
  right: 126rpx;
  top: 20rpx;
  width: 78rpx;
  height: 94rpx;
  z-index: 1;
  box-sizing: border-box;
  padding: 14rpx 12rpx;
  border: 1rpx solid rgba(247, 202, 153, 0.84);
  border-radius: 16rpx;
  background: rgba(255, 251, 244, 0.72);
  box-shadow: 0 10rpx 22rpx rgba(123, 76, 30, 0.06);
  transform: rotate(-8deg);
}

.hero-note-card text {
  display: block;
  height: 6rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 16, 0.34);
}

.hero-note-card text:nth-child(2) {
  width: 70%;
}

.hero-note-card text:nth-child(3) {
  width: 84%;
  margin-bottom: 0;
}

.hero-dumbbell {
  position: absolute;
  right: 114rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  z-index: 4;
  transform: rotate(-18deg);
}

.hero-dumbbell view {
  display: block;
  background: #ff8a18;
}

.hero-dumbbell view:first-child,
.hero-dumbbell view:last-child {
  width: 12rpx;
  height: 30rpx;
  border-radius: 6rpx;
}

.hero-dumbbell view:nth-child(2) {
  width: 42rpx;
  height: 8rpx;
  border-radius: 999rpx;
}

.hero-food-dot {
  position: absolute;
  right: 168rpx;
  bottom: 64rpx;
  width: 34rpx;
  height: 26rpx;
  z-index: 2;
  border-radius: 14rpx;
  background: rgba(71, 163, 124, 0.22);
  transform: rotate(18deg);
}

.hero-spark {
  position: absolute;
  z-index: 2;
  width: 20rpx;
  height: 20rpx;
  background: #ffd36f;
  transform: rotate(45deg);
}

.spark-one {
  right: 112rpx;
  top: 4rpx;
}

.spark-two {
  right: 182rpx;
  bottom: 28rpx;
  width: 14rpx;
  height: 14rpx;
  opacity: 0.78;
}

.nutrition-card {
  position: relative;
  margin-top: 0;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(240, 220, 199, 0.94);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 22rpx 54rpx rgba(91, 58, 25, 0.065),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
}

.calorie-area {
  position: relative;
  min-height: 316rpx;
  padding: 32rpx 28rpx 22rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.calorie-copy {
  position: relative;
  z-index: 4;
  width: 430rpx;
}

.card-label {
  display: block;
  color: #1f2733;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.calorie-line {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  margin-top: 14rpx;
}

.remaining-kcal {
  color: #ff7a10;
  font-size: 98rpx;
  line-height: 0.92;
  font-weight: 900;
}

.kcal-unit {
  padding-bottom: 12rpx;
  color: #1f2733;
  font-size: 30rpx;
  font-weight: 700;
}

.food-progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  color: #5f6671;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 700;
}

.home-progress,
.macro-track {
  width: 100%;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f0e7df;
}

.home-progress {
  margin-top: 10rpx;
}

.home-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff7a10, #ff9d24);
}

.target-line {
  display: block;
  margin-top: 18rpx;
  color: #777d86;
  font-size: 24rpx;
  line-height: 1.34;
  font-weight: 600;
}

.coach-bubble {
  position: absolute;
  right: 118rpx;
  top: 50rpx;
  z-index: 5;
  max-width: 132rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid #f4dec7;
  border-radius: 24rpx;
  background: #fff8ef;
  color: #ff7a10;
  font-size: 23rpx;
  line-height: 1.28;
  font-weight: 900;
}

.coach-bubble::after {
  content: "";
  position: absolute;
  right: -16rpx;
  top: 58rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #fff8ef;
}

.coach-large {
  position: absolute;
  right: -30rpx;
  bottom: -6rpx;
  width: 218rpx;
  height: 260rpx;
  z-index: 3;
}

.coach-large::before,
.coach-large::after {
  content: "";
  position: absolute;
  z-index: 4;
  width: 32rpx;
  height: 32rpx;
  background: #ffd36f;
  transform: rotate(45deg);
}

.coach-large::before {
  left: -24rpx;
  top: 126rpx;
}

.coach-large::after {
  left: 10rpx;
  top: 160rpx;
  width: 22rpx;
  height: 22rpx;
}

.coach-body-img {
  display: block;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 20rpx 34rpx rgba(61, 38, 16, 0.12));
}

.macro-strip {
  display: flex;
  position: relative;
  z-index: 4;
  margin: 0 20rpx 22rpx;
  padding: 24rpx 0 20rpx;
  border-top: 1rpx solid rgba(235, 219, 202, 0.9);
  border-radius: 0 0 22rpx 22rpx;
  background: linear-gradient(180deg, rgba(255, 250, 244, 0.42), rgba(255, 255, 255, 0.78));
}

.macro-item {
  flex: 1;
  padding: 0 24rpx;
  border-right: 1rpx solid rgba(235, 219, 202, 0.95);
}

.macro-item:last-child {
  border-right: 0;
}

.macro-name,
.macro-value,
.macro-percent {
  display: block;
}

.macro-name {
  color: #3f4854;
  font-size: 26rpx;
  line-height: 1.22;
  font-weight: 800;
}

.macro-value {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.15;
  font-weight: 900;
}

.macro-track {
  height: 12rpx;
  margin-top: 14rpx;
}

.macro-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #47a37c;
}

.fat .macro-fill {
  background: #ff7a10;
}

.carb .macro-fill {
  background: #2b83d3;
}

.macro-percent {
  margin-top: 12rpx;
  color: #515963;
  font-size: 24rpx;
  line-height: 1.15;
  font-weight: 500;
}

.records-shell {
  padding: 24rpx 22rpx 28rpx;
  border: 1rpx solid rgba(240, 220, 199, 0.94);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 22rpx 54rpx rgba(91, 58, 25, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.records-title-row,
.group-head,
.record-row,
.quick-actions {
  display: flex;
}

.records-title-row,
.group-head {
  align-items: center;
  justify-content: space-between;
}

.records-title {
  color: #1f2733;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 900;
}

.view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #8f949c;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
}

.record-group {
  margin-top: 22rpx;
  padding: 22rpx 18rpx 20rpx;
  border: 1rpx solid rgba(241, 224, 207, 0.92);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.84);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.record-table-wrap {
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(242, 225, 208, 0.9);
  border-radius: 20rpx;
  background: rgba(255, 253, 249, 0.72);
}

.record-table-scroll {
  width: 100%;
}

.record-table {
  width: 1040rpx;
}

.table-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid rgba(241, 230, 220, 0.9);
}

.table-row:last-child {
  border-bottom: 0;
}

.table-head {
  min-height: 64rpx;
  background: rgba(255, 248, 239, 0.86);
  color: #5e6671;
  font-size: 23rpx;
  font-weight: 900;
}

.cell {
  display: block;
  box-sizing: border-box;
  padding: 0 14rpx;
  color: #202733;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.table-head .cell {
  color: #6f7480;
  font-size: 23rpx;
}

.meal-cell {
  width: 110rpx;
}

.name-cell {
  width: 180rpx;
}

.amount-cell {
  width: 170rpx;
}

.kcal-cell {
  width: 150rpx;
  text-align: right;
}

.macro-cell {
  width: 105rpx;
  text-align: right;
}

.action-cell {
  width: 110rpx;
  text-align: center;
}

.table-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 42rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(255, 241, 228, 0.86);
  color: #c6814c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.group-name {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #1f2733;
  font-size: 29rpx;
  line-height: 1.2;
  font-weight: 900;
}

.group-calories {
  display: flex;
  align-items: center;
  gap: 2rpx;
  color: #1f2733;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 800;
}

.group-icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.chevron-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.chevron-icon.orange {
  width: 26rpx;
  height: 26rpx;
  flex-basis: 26rpx;
}

.record-row {
  position: relative;
  align-items: center;
  gap: 18rpx;
  padding-top: 24rpx;
  padding-right: 30rpx;
}

.record-copy {
  flex: 1;
  min-width: 198rpx;
}

.record-name,
.record-amount {
  display: block;
}

.record-name {
  color: #1f2733;
  font-size: 30rpx;
  line-height: 1.18;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-amount {
  margin-top: 10rpx;
  color: #7b818a;
  font-size: 25rpx;
  line-height: 1.22;
  font-weight: 500;
}

.record-stats {
  flex: 0 0 166rpx;
  min-width: 166rpx;
  text-align: right;
}

.record-kcal {
  display: block;
  color: #1f2733;
  font-size: 29rpx;
  line-height: 1.12;
  font-weight: 800;
}

.macro-tags {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.12;
  font-weight: 700;
}

.macro-tags .p {
  color: #43a278;
}

.macro-tags .f {
  color: #ff7a10;
}

.macro-tags .c {
  color: #2b83d3;
}

.delete-link {
  position: absolute;
  right: -6rpx;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin: 0;
  padding: 0;
  transform: translateY(-12%);
  border-radius: 50%;
  background: transparent;
  color: #c8a78a;
  line-height: 34rpx;
}

.delete-link image {
  display: block;
  width: 26rpx;
  height: 26rpx;
  margin: 4rpx;
}

.empty-records {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 42rpx 0 28rpx;
  color: #7a7f88;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.quick-actions {
  gap: 24rpx;
  margin-top: 28rpx;
}

.quick-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  flex: 1;
  height: 108rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 30rpx;
}

.food-action {
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 16, 0.18);
}

.exercise-action {
  border: 1rpx solid rgba(239, 219, 195, 0.96);
  background: rgba(255, 255, 255, 0.86);
  color: #1f2733;
}

.action-icon,
.action-title,
.action-subtitle {
  display: block;
}

.action-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
}

.action-title {
  color: inherit;
  font-size: 32rpx;
  line-height: 1.08;
  font-weight: 900;
  text-align: left;
}

.action-subtitle {
  margin-top: 8rpx;
  color: rgba(31, 39, 51, 0.52);
  font-size: 23rpx;
  line-height: 1.15;
  font-weight: 600;
  text-align: left;
}

.food-action .action-subtitle {
  color: rgba(255, 255, 255, 0.82);
}

.food-modal-mask,
.exercise-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  padding: 0 28rpx calc(env(safe-area-inset-bottom) + 140rpx);
  box-sizing: border-box;
  background: rgba(31, 39, 51, 0.24);
}

.food-modal,
.exercise-modal {
  width: 100%;
  padding: 28rpx 26rpx 26rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(240, 220, 199, 0.96);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 88% 0%, rgba(255, 139, 28, 0.14), transparent 30%),
    rgba(255, 255, 255, 0.98);
  box-shadow: 0 -18rpx 58rpx rgba(72, 45, 20, 0.16);
  animation: exerciseDrawerUp 180ms ease-out both;
}

.food-modal {
  display: flex;
  flex-direction: column;
  max-height: 76vh;
  padding-bottom: 22rpx;
}

.food-modal-scroll {
  flex: 1;
  min-height: 0;
  max-height: calc(76vh - 122rpx);
}

@keyframes exerciseDrawerUp {
  from {
    opacity: 0;
    transform: translateY(56rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.food-modal-head,
.exercise-modal-head {
  display: flex;
  align-items: center;
  flex-direction: row-reverse;
  justify-content: flex-end;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.food-modal-copy,
.exercise-modal-copy {
  flex: 1;
  min-width: 0;
}

.food-modal-title,
.food-modal-subtitle,
.food-field-title,
.exercise-modal-title,
.exercise-modal-subtitle,
.exercise-field-title {
  display: block;
}

.food-modal-title,
.exercise-modal-title {
  color: #1f2733;
  font-size: 36rpx;
  line-height: 1.16;
  font-weight: 900;
}

.food-modal-subtitle,
.exercise-modal-subtitle {
  margin-top: 8rpx;
  color: #7d828a;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 600;
}

.food-coach {
  width: 124rpx;
  height: 124rpx;
  flex: 0 0 124rpx;
  filter: drop-shadow(0 14rpx 26rpx rgba(133, 78, 24, 0.14));
}

.exercise-coach {
  width: 164rpx;
  height: 164rpx;
  flex: 0 0 164rpx;
  filter: drop-shadow(0 14rpx 26rpx rgba(133, 78, 24, 0.14));
}

.food-form-block,
.exercise-form-block {
  margin-top: 18rpx;
  padding: 22rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(242, 225, 208, 0.9);
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.84);
  overflow: hidden;
}

.food-field-title,
.exercise-field-title {
  margin-bottom: 16rpx;
  color: #1f2733;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 900;
}

.food-meal-grid,
.exercise-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.food-meal-grid button,
.exercise-option-grid button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  margin: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fff7ec;
  color: #1f2733;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-meal-grid button.active,
.exercise-option-grid button.active {
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(255, 122, 16, 0.16);
}

.exercise-duration-input {
  height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #f0dfc9;
  border-radius: 18rpx;
  background: #fffaf2;
  color: #1f2733;
  font-size: 30rpx;
  font-weight: 700;
}

.food-input {
  width: 100%;
  min-height: 92rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #f0dfc9;
  border-radius: 18rpx;
  background: #fffaf2;
  color: #1f2733;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}

.food-parse-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 18rpx 0 0;
  border-radius: 22rpx;
  background: #1f2733;
  color: #fff8ef;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.food-parsed {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(241, 231, 217, 0.92);
}

.food-parsed:last-child {
  border-bottom: 0;
}

.food-parsed-name {
  margin-right: 12rpx;
  color: #1f2733;
  font-size: 28rpx;
  font-weight: 900;
}

.food-parsed-amount,
.food-parsed-macro,
.food-muted {
  color: #7d828a;
  font-size: 23rpx;
  line-height: 1.28;
  font-weight: 600;
}

.food-parsed-calorie {
  color: #1f2733;
  font-size: 28rpx;
  font-weight: 900;
}

.food-failed {
  margin-top: 14rpx;
  color: #b42318;
  font-size: 23rpx;
  font-weight: 700;
}

.food-modal-actions,
.exercise-modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.food-modal-actions button,
.exercise-modal-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 82rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.food-meal-grid button::after,
.exercise-option-grid button::after,
.food-parse-button::after,
.food-modal-actions button::after,
.exercise-modal-actions button::after {
  border: 0;
}

.food-cancel,
.exercise-cancel {
  border: 1rpx solid rgba(239, 219, 195, 0.96);
  background: rgba(255, 255, 255, 0.86);
  color: #6f7480;
}

.food-save,
.exercise-save {
  background: linear-gradient(135deg, #ff7a10, #ff8f18);
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 16, 0.18);
}

/* AI 分解食材明细 */
.breakdown-wrap {
  margin-top: 8rpx;
  padding: 10rpx 16rpx;
  background: #fffaf2;
  border-radius: 10rpx;
}

.breakdown-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #7b6957;
}

.bd-name {
  flex: 1;
  font-weight: 600;
  color: #202733;
}

.bd-amount {
  min-width: 60rpx;
  text-align: right;
}

.bd-est {
  color: #f28c28;
  font-size: 22rpx;
}

.bd-cal {
  min-width: 72rpx;
  text-align: right;
  color: #202733;
  font-weight: 600;
}
