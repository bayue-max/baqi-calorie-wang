.legal-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 56rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% 12%, rgba(255, 139, 24, 0.16), transparent 28%),
    radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.96), transparent 26%),
    #fff8ef;
  color: #1f2733;
}

.legal-hero {
  margin-bottom: 24rpx;
}

.legal-title {
  display: block;
  color: #1f2733;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.1;
}

.legal-subtitle,
.legal-date {
  display: block;
  margin-top: 14rpx;
  color: #7d828a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.legal-date {
  color: #9a5a12;
  font-size: 23rpx;
}

.legal-card {
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(239, 219, 195, 0.96);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 40rpx rgba(74, 48, 23, 0.07);
}

.section + .section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #1f2733;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.paragraph {
  display: block;
  color: #5f6470;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.65;
}

.paragraph + .paragraph {
  margin-top: 10rpx;
}
